# Скопируйте в .env и заполните. Обязательные значения помечены.
# --- PostgreSQL ---
# Обязательно: DB_HOST (в Compose всегда postgres; значения ниже — локальные заглушки), DB_NAME, DB_USER, DB_PASSWORD.
DB_HOST=postgres
DB_PORT=
DB_NAME=user
DB_USER=user
DB_PASSWORD=change-me-local-only
DB_TIMEOUT_SECONDS=
# --- Сервис ---
LOG_LEVEL=
# Необязательно: ожидание чужой блокировки при миграциях, секунд (по умолчанию 30).
MIGRATION_LOCK_TIMEOUT_SECONDS=
# Необязательно: хэширование паролей (argon2id, 64 МиБ на хэш).
# Одновременно хэшируется до HASH_CONCURRENCY паролей (по умолчанию 4).
HASH_CONCURRENCY=
# В очереди ждут не больше HASH_QUEUE_MAX запросов (32) не дольше HASH_QUEUE_TIMEOUT_SECONDS (5), иначе 503.
HASH_QUEUE_MAX=
HASH_QUEUE_TIMEOUT_SECONDS=
# Только docker-compose.dev.yml: порт на хосте (контейнер всегда слушает 8000); по умолчанию 8003.
USER_HTTP_PORT=
# Необязательно: базовый URL OTLP HTTP collector, без /v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
